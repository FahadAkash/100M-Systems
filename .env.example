# Application Server Configuration
PORT=8080
BASE_URL=http://localhost:8080
STORAGE_MODE=postgres

# ==============================================================================
# RATE LIMITING CONFIGURATION
# ==============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ==============================================================================
# POSTGRESQL CONFIGURATION (LAN / Server IP)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=appdb
POSTGRES_PORT=5432

DB_HOST=192.168.0.113
DB_PORT=5432
DB_NAME=appdb
DB_USER=postgres
DB_PASSWORD=postgres_secure_pass

# Standard PostgreSQL Connection URL
DATABASE_URL=postgresql://postgres:postgres_secure_pass@192.168.0.113:5432/appdb?sslmode=disable

# ==============================================================================
# REDIS CONFIGURATION (LAN / Server IP)
# ==============================================================================
REDIS_HOST=192.168.0.113
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass

# Standard Redis Connection URL
REDIS_URL=redis://:redis_secure_pass@192.168.0.113:6379/0

# ==============================================================================
# APACHE KAFKA CONFIGURATION (Streaming Analytics)
# ==============================================================================
KAFKA_ENABLED=false
KAFKA_BROKERS=192.168.0.113:9092
KAFKA_TOPIC=url-clicks
KAFKA_GROUP_ID=url-shortener-analytics

# ==============================================================================
# PRODUCTION SERVER LATENCY SIMULATOR (Mimic Real WAN/Datacenter Delay)
# ==============================================================================
SIMULATE_LATENCY_ENABLED=false
SIMULATE_LATENCY_MIN_MS=15
SIMULATE_LATENCY_MAX_MS=40


